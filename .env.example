# Copy file này thành .env (hoặc .env.staging / .env.uat / .env.prod) và điền giá trị thật.
# KHÔNG commit file .env thật lên git.

# Môi trường: staging | uat | prod
TEST_ENV=staging

# Base URL theo môi trường
BASE_URL=https://automationexercise.com
API_BASE_URL=https://automationexercise.com/api

# Tài khoản test (thông tin bí mật - chỉ để trong .env thật)
TEST_USER_EMAIL=
TEST_USER_PASSWORD=

# Cấu hình run
HEADLESS=true
RETRIES=1
WORKERS=4
TIMEOUT=30000
