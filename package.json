{
  "name": "automationexercise-playwright",
  "version": "1.0.0",
  "description": "Playwright + TypeScript automation framework for automationexercise.com (POM, UI + API, multi-env Staging/UAT/Prod)",
  "scripts": {
    "test": "playwright test",
    "test:staging": "TEST_ENV=staging playwright test",
    "test:uat": "TEST_ENV=uat playwright test",
    "test:prod": "TEST_ENV=prod playwright test",
    "test:ui-mode": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "report": "playwright show-report"
  },
  "keywords": [
    "playwright",
    "typescript",
    "automation-testing",
    "pom",
    "e2e"
  ],
  "author": "B.Tuyen <hathibichtuyen20082001@gmail.com>",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.1",
    "dotenv": "^17.4.2"
  },
  "dependencies": {
    "csv-parse": "^7.0.1"
  }
}
